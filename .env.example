# Copy this file to .env (next to go.mod) and fill in the values. Never commit .env.

# Discord Developer Portal → your application → OAuth2
DISCORD_CLIENT_ID=1525921185903149096
DISCORD_CLIENT_SECRET=

# Must match one of the Redirects in the Developer Portal exactly.
# Local development (Vite on 5173 proxies /api to Go):
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Production example:
# DISCORD_REDIRECT_URI=https://girlscan.example/api/auth/callback

# Random string, at least 32 characters. Signs the login cookie.
# Leave it out: the server generates one and appends it to .env on first start.
# SESSION_SECRET=
