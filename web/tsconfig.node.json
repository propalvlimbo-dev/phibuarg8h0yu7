{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "outDir": "node_modules/.tmp/tsconfig.node",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "vite.config.ts",
    "dev-auth.ts"
  ]
}
